# Copier en deploy.env (non versionné) et compléter.
# Accès SSH à l'hébergement OVH (espace client > Hébergements > FTP-SSH).
HACHI_SSH=utilisateur@ssh.cluster0XX.hosting.ovh.net
# Dossier racine du site (Multisite), relatif au dossier personnel.
# Vide si l'utilisateur SSH est dédié au site : son dossier personnel est alors la racine.
HACHI_DIR=
# Adresse du site, affichée à la fin de la mise en ligne.
HACHI_URL=https://hachi.example.com
