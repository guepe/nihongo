# Configuration Apache pour l'hébergement OVH (copiée telle quelle dans dist/).

# Une PWA ne s'installe qu'en HTTPS.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Toujours revalider : index.html, sw.js et deck.json doivent être frais pour que les
  # mises à jour arrivent. Le service worker garde de toute façon une copie hors-ligne.
  Header set Cache-Control "no-cache"
  # Les fichiers de assets/ ont un nom qui change à chaque version : cache permanent.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
